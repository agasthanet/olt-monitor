# Copy ke .env dan sesuaikan

OLT_IP=192.168.1.1
SNMP_COMMUNITY=public
SNMP_PORT=161
SNMP_TIMEOUT=5
SNMP_RETRIES=2

# Slot board yang dipantau (C320 biasanya 1,2)
BOARDS=1,2
MAX_PON=16
MAX_ONU=128

# auto | v1 | v2
FIRMWARE_MODE=auto

# Threshold Rx Power (dBm)
RX_GOOD=-25.0
RX_WARNING=-28.0

# Path mapping ODP
ODP_MAPPING_FILE=data/odp_mapping.csv

# true = pakai data dummy (untuk test UI)
DEMO_MODE=true

# Cache SNMP (detik)
CACHE_SECONDS=180
